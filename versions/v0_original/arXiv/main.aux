\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scenario B --- Stable double-support stance, sustained 8\,N pHRI + 6\,N periodic shocks at 1\,Hz. D7 shows barely perceptible blips (4.15\,mm peak) at each event, while D1 peaks at 15.77\,mm. D4--D6 are omitted for readability and reported in Table~\ref {tab:scenarioB}; D7's covariance inflation ($\alpha =4$) marginally outperforms D6 (4.15 vs.\ 4.32\,mm peak), confirming accelerated Kalman re-convergence.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:scenarioB}{{2}{8}{Scenario B --- Stable double-support stance, sustained 8\,N pHRI + 6\,N periodic shocks at 1\,Hz. D7 shows barely perceptible blips (4.15\,mm peak) at each event, while D1 peaks at 15.77\,mm. D4--D6 are omitted for readability and reported in Table~\ref {tab:scenarioB}; D7's covariance inflation ($\alpha =4$) marginally outperforms D6 (4.15 vs.\ 4.32\,mm peak), confirming accelerated Kalman re-convergence}{figure.2}{}}
