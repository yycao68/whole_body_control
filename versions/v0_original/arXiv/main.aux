\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scenario A --- Fixed double-support stance, 8\,N step pHRI at $t=0.5$\,s. \textit  {Top:} Cartesian end-effector error norm $\|e\|$ over time. D7 (Kalman-augmented) converges to sub-0.05\,mm within ${\sim }0.3$\,s of disturbance onset. D3 (fixed-base MPC) diverges to 12\,mm because the biased $B_d$ corrupts the Kalman estimate. \textit  {Bottom:} RMS and steady-state~(SS) error bar chart. D4--D6 are omitted for readability and reported in Table~\ref {tab:scenarioA}.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:scenarioA}{{1}{7}{Scenario A --- Fixed double-support stance, 8\,N step pHRI at $t=0.5$\,s. \textit {Top:} Cartesian end-effector error norm $\|e\|$ over time. D7 (Kalman-augmented) converges to sub-0.05\,mm within ${\sim }0.3$\,s of disturbance onset. D3 (fixed-base MPC) diverges to 12\,mm because the biased $B_d$ corrupts the Kalman estimate. \textit {Bottom:} RMS and steady-state~(SS) error bar chart. D4--D6 are omitted for readability and reported in Table~\ref {tab:scenarioA}}{figure.1}{}}
