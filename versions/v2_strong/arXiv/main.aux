\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {X-E}}Scenario C: Unitree G1 Real Model, Fixed Stance}{7}{subsection.10.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scenario B --- double-support stance, sustained 8\,N pHRI + 6\,N periodic shocks at 1\,Hz. The disturbance observer removes the steady-state bias (D5 is offset, D6/D7 track to a few mm); with both feet planted, the free-space (D3) and contact-consistent (D7) predictors coincide (Table~\ref {tab:scenarioB}).}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:scenarioB}{{2}{8}{Scenario B --- double-support stance, sustained 8\,N pHRI + 6\,N periodic shocks at 1\,Hz. The disturbance observer removes the steady-state bias (D5 is offset, D6/D7 track to a few mm); with both feet planted, the free-space (D3) and contact-consistent (D7) predictors coincide (Table~\ref {tab:scenarioB})}{figure.2}{}}
